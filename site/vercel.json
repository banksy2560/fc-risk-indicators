{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/typologies", "destination": "/", "permanent": true },
    { "source": "/indicators", "destination": "/", "permanent": true },
    { "source": "/controls", "destination": "/", "permanent": true },
    { "source": "/explorer", "destination": "/", "permanent": true },
    { "source": "/relationships", "destination": "/", "permanent": true },
    { "source": "/coverage", "destination": "/", "permanent": true }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] },
    { "source": "/data/(.*)", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" } ] }
  ]
}
